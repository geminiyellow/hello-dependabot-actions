# Server Configuration
SERVER_PORT=8080

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-256-bit-secret-key-in-production-environment-now-please
JWT_ISSUER=aac-service
JWT_ACCESS_TOKEN_EXPIRATION=900000      # 15 minutes
JWT_REFRESH_TOKEN_EXPIRATION=604800000  # 7 days
JWT_TEMP_TOKEN_EXPIRATION=300000        # 5 minutes

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Keycloak Configuration
KEYCLOAK_SERVER_URL=http://localhost:8180
KEYCLOAK_REALM=enterprise
KEYCLOAK_CLIENT_ID=aac-service
KEYCLOAK_CLIENT_SECRET=your-client-secret-here
KEYCLOAK_REDIRECT_URI=http://localhost:8080/auth/callback

# IMC Configuration
IMC_BASE_URL=http://localhost:8081
IMC_API_KEY=imc-api-key-here
